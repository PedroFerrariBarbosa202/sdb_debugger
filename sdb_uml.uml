@startuml
package domain{
enum register_id{
  // GENERATED BY PREPROCESSOR
  // USING X MACROS
}

enum register_type{
 gpr,
 sub_gpr,
 fpr,
 dr
}

enum register_format{
 uint,
 double_float,
 long_double,
 vector
}

class virt_addr{
  uint64_t addr()
}

struct register_info{
      register_id id
      string_view name
      int32_t dwarf_id
      size_t size
      size_t offset
      register_type type
      register_format format
}
register_info *.. register_id
register_info *.. register_type
register_info *.. register_format

class register_metadata{
 - {static} register_info g_register_infos[]

 - {static} register_info& register_info_by(F f)
 + {static} register_info& register_info_by_id(register_id id)
 + {static} register_info& register_info_by_name(register_id id)
 + {static} register_info& register_info_by_dwarf(register_id id)
}
register_metadata *.. register_info


class registers{
 + variant<...> read();
 + variant<...> write();
 + T read_by_id_as();
 + void write_by_id();
 + registers::value parse_register_value();

 friend process;
 - byte128 widen();
 - user data_;
 - process *proc_;
}

registers <.. register_metadata

enum process_state{
    stopped,
    running,
    exited,
    terminated,
}

class stop_reason{
  - process_state reason
  - uint8_t info
}
stop_reason *.. process_state

class process{
 - pid_t pid_ = 0;
 - bool terminate_on_end_ = true;
 - bool is_attached_ = true;
 - process_state state_ = process_state::stopped;

 + {static} unique_ptr<process> launch()
 + {static} unique_ptr<process> attach()
 + void resume()
 + stop_reason wait_on_signal();
 + pid_t pid() const;
 + process_state state();
}
process <-- process_state
process *-- stop_reason
process o-- pipe
process *-- registers

class pipe{
  - {static} unsigned read_fd = 0;
  - {static} unsigned write_fd = 1;
  - int fds_[2];

  + int get_read() const;
  + int get_write() const;
  + int release_read();
  + int release_write();
  + void close_read();
  + void close_write();

  + vector<byte> read();
  + void write(byte* from, size_t bytes);
}
}

package presentation{
abstract class sdb_cli{
  + {abstract} unique_ptr<general_view> create_general_view();
  + {abstract} unique_ptr<register_view> create_register_view();
  + {abstract} unique_ptr<error_view> create_error_view();
  + {static} bool is_prefix();
  + {static} vector<string> split();
}

class minimal_sdb_cli{
 + unique_ptr<general_view> create_general_view();
 + unique_ptr<register_view> create_register_view();
 + unique_ptr<error_view> create_error_view();
}

class json_sdb_cli{
 + unique_ptr<general_view> create_general_view();
 + unique_ptr<register_view> create_register_view();
 + unique_ptr<error_view> create_error_view();
}

abstract class general_view{
 + {abstract} ~general_view();
 + {abstract} void print_help();
}

abstract class register_view{
 + {abstract} ~general_view();
 + {abstract} void print_help();
}

abstract class error_view{
 + {abstract} ~general_view();
 + {abstract} void print_help();
}

class minimal_general_view{
 + void print_help();
}

class minimal_register_view{
 + void print_register();
}

class minimal_error_view{
 + void print_stop_reason();
 + void print_error();
}

class json_general_view{
 + void print_help();
}

class json_register_view{
 + void print_register();
}

class json_error_view{
 + void print_stop_reason();
 + void print_error();
}

sdb_cli <|-- minimal_sdb_cli
sdb_cli <|-- json_sdb_cli

minimal_sdb_cli --> general_view
minimal_sdb_cli --> register_view
minimal_sdb_cli --> error_view

json_sdb_cli --> general_view
json_sdb_cli --> register_view
json_sdb_cli --> error_view

minimal_general_view <|-- general_view
minimal_register_view <|-- register_view
minimal_error_view <|-- error_view

json_general_view <|-- general_view
json_register_view <|-- register_view
json_error_view <|-- error_view
}

package application{
class sdb{
  + unique_ptr<process> attach();
  + void handle_command();
  + void update_loop();
  - void handle_register_command();
  - void handle_register_read();
  - void handle_register_write();
}
sdb --> process
sdb --> sdb_cli
}
@enduml
