@startuml
enum register_id{
  // GENERATED BY PREPROCESSOR
  // USING X MACROS
}

enum register_type{
 gpr,
 sub_gpr,
 fpr,
 dr
}

enum register_format{
 uint,
 double_float,
 long_double,
 vector
}

class virt_addr{
  uint64_t addr()
}

struct register_info{
      register_id id
      string_view name
      int32_t dwarf_id
      size_t size
      size_t offset
      register_type type
      register_format format
}
register_info *.. register_id
register_info *.. register_type
register_info *.. register_format

class register_metadata{
 - {static} register_info g_register_infos[]

 - {static} register_info& register_info_by(F f)
 + {static} register_info& register_info_by_id(register_id id)
 + {static} register_info& register_info_by_name(register_id id)
 + {static} register_info& register_info_by_dwarf(register_id id)
}
register_metadata *.. register_info


class registers{
 + variant<...> read();
 + variant<...> write();
 + T read_by_id_as();
 + void write_by_id();
 + registers::value parse_register_value();

 friend process;
 - byte128 widen();
 - user data_;
 - process *proc_;
}

registers <.. register_metadata

enum process_state{
    stopped,
    running,
    exited,
    terminated,
}

class stop_reason{
  - process_state reason
  - uint8_t info
}
stop_reason *.. process_state

class process{
 - pid_t pid_ = 0;
 - bool terminate_on_end_ = true;
 - bool is_attached_ = true;
 - process_state state_ = process_state::stopped;

 + {static} unique_ptr<process> launch()
 + {static} unique_ptr<process> attach()
 + void resume()
 + stop_reason wait_on_signal();
 + pid_t pid() const;
 + process_state state();
}
process <-- process_state
process *-- stop_reason
process o-- pipe
process *-- registers

class pipe{
  - {static} unsigned read_fd = 0;
  - {static} unsigned write_fd = 1;
  - int fds_[2];

  + int get_read() const;
  + int get_write() const;
  + int release_read();
  + int release_write();
  + void close_read();
  + void close_write();

  + vector<byte> read();
  + void write(byte* from, size_t bytes);
}

class sdb_cli{
  + {static} void print_error();
  + {static} void print_register();
  + {static} void print_stop_reason();
  + {static} void print_help();
  + {static} bool is_prefix();
  + {static} vector<string> split();
}

class sdb{
  + {static} unique_ptr<process> attach();
  + {static} void handle_command();
  + {static} void update_loop();
  - {static} void handle_register_command();
  - {static} void handle_register_read();
  - {static} void handle_register_write();
}
sdb --> process
sdb --> sdb_cli
@enduml
